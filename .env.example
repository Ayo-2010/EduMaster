# App
NODE_ENV="development"
PORT=3000

# Redis (for caching and queues)
REDIS_URL="redis://localhost:6379"

# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""